# Token de PandaScore (solo servidor, NUNCA con prefijo NEXT_PUBLIC_)
PANDASCORE_API_TOKEN=

# Secreto (mín. 16 caracteres aleatorios) para /api/cron/warm y /api/health.
# En Vercel, si existe, se envía automáticamente en los cron jobs como "Authorization: Bearer <valor>".
CRON_SECRET=

# --- Paso 12: varias fuentes (todas solo servidor, nunca NEXT_PUBLIC_*) ---
# Supabase: Project settings > API. La service role key salta RLS: guárdala solo en Vercel/servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# CitoAPI (500 llamadas/mes) y API de Riot (futuro): opcionales.
CITOAPI_KEY=
RIOT_API_KEY=
# Leaguepedia (Cargo API): sin clave. El acceso anónimo está muy limitado (~1 consulta/min, 500 filas por página).
# Oracle's Elixir: URL https o ruta local del CSV anual (p. ej. 2026_LoL_esports_match_data_from_OraclesElixir.csv).
# Cópiala desde la página oficial de descargas; no se fija una URL en el código porque no se ha podido verificar.
ORACLESELIXIR_CSV_URL=
